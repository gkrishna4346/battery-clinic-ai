# Copy this file to .streamlit/secrets.toml and fill in what you need.
# secrets.toml is private: never commit it to GitHub (it is listed in .gitignore).
# On Streamlit Community Cloud, paste the same lines into the app's Settings -> Secrets.

# Mr. GK AI mode (without it, Mr. GK works in free Guide mode)
# ANTHROPIC_API_KEY = "sk-ant-..."

# Store data versions in GitHub when deployed (token needs Contents: read & write on the repo)
# GITHUB_TOKEN = "github_pat_..."
# GITHUB_REPO = "your-user/batterysense"
# GITHUB_BRANCH = "main"
